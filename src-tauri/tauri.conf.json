{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustMail",
  "version": "0.3.0",
  "identifier": "pl.rustmail.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "RustMail", "decorations": false, "width": 1280, "height": 800, "minWidth": 900, "minHeight": 560 }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "category": "Email",
    "shortDescription": "Bezpieczny klient poczty Gmail",
    "longDescription": "RustMail – konwersacyjny klient Gmail z naciskiem na bezpieczeństwo.",
    "linux": { "appimage": { "bundleMediaFramework": false } }
  }
}
